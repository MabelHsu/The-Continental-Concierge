# ============================================================
# The Continental Concierge — Environment Template
# ============================================================
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.
#
#   cp .env.template .env
# ============================================================


# ── AlloyDB Omni (local dev — docker compose up -d) ──────────────────────────
# These defaults match the docker-compose.yml service.
# Change ALLOYDB_PASSWORD to whatever you set in docker-compose or passed via env.

ALLOYDB_HOST=localhost
ALLOYDB_PORT=5432
ALLOYDB_DATABASE=continental
ALLOYDB_USER=continental_app
ALLOYDB_PASSWORD=continental-dev

# Password used by docker-compose to initialise the postgres superuser.
# Must match ALLOYDB_PASSWORD if you set continental_app up as the superuser,
# or be a separate value if you create continental_app as a secondary user.
DB_PASSWORD=continental-dev


# ── Vertex AI ────────────────────────────────────────────────────────────────
# Used by: agent model calls, seed_embeddings.py
# Authenticate first:  gcloud auth application-default login

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1


# ── Agent Engine (after Phase 6 deployment) ──────────────────────────────────
AGENT_ENGINE_ID=


# ── MCP Server (after Phase 7 Cloud Run deployment) ──────────────────────────
MCP_SERVER_URL=


# ── Production: Cloud AlloyDB via Terraform (Phase 5+) ───────────────────────
# Uncomment and fill in when deploying to staging / production.
# The Auth Proxy runs as a sidecar in Cloud Run — ALLOYDB_HOST stays 127.0.0.1.
#
# ALLOYDB_HOST=127.0.0.1
# ALLOYDB_PORT=5432
# ALLOYDB_DATABASE=continental
# ALLOYDB_USER=continental_app
# ALLOYDB_PASSWORD=<from Secret Manager: continental-db-password>
# ALLOYDB_INSTANCE_URI=projects/PROJECT/locations/REGION/clusters/continental-cluster/instances/continental-primary
