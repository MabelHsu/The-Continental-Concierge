# The Continental Concierge — Environment Variables
# Copy to .env and fill in your values.

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1

# AlloyDB
ALLOYDB_HOST=127.0.0.1
ALLOYDB_PORT=5432
ALLOYDB_DATABASE=continental
ALLOYDB_USER=continental_app
ALLOYDB_PASSWORD=your-password
ALLOYDB_INSTANCE_URI=projects/PROJECT/locations/REGION/clusters/continental-cluster/instances/continental-primary

# Agent Engine (after deployment)
AGENT_ENGINE_ID=

# MCP Server (after Cloud Run deployment)
MCP_SERVER_URL=
